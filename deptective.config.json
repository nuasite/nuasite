{
	"checkDevDependencies": true,
	"packageOverrides": {
		"@nuasite/nua": {
			"allowedUnusedDependencies": [
				"@nuasite/cli",
				"@nuasite/components",
				"@nuasite/core",
				"@nuasite/llm-enhancements",
				"@tailwindcss/typography",
				"flowbite",
				"tailwindcss",
				"typescript",
				"vite"
			]
		},
		"@nuasite/cms": {
			"excludePatterns": ["**/*.d.ts", "**/generated/**", "src/editor/**", "src/admin/**"],
			"testPatterns": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/test/**", "src/index.ts"],
			"sourcePatterns": ["src/**/*.{ts,tsx,astro}"]
		},
		"@nuasite/components": {
			"sourcePatterns": ["src/**/*.{ts,tsx,astro}"]
		},
		"@nuasite/astro-fragments": {
			"sourcePatterns": ["src/**/*.{ts,tsx}", "components/**/*.astro"]
		},
		"@nuasite/cms-studio": {
			"excludePatterns": ["**/*.d.ts", "src/spa/**", "vite.config.ts"]
		},
		"playground": {
			"allowedUnusedDependencies": ["@nuasite/nua"]
		}
	}
}
