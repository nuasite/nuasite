{
	"name": "@nuasite/cli",
	"version": "0.64.1",
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist/**",
		"src/**",
		"README.md",
		"package.json"
	],
	"homepage": "https://github.com/nuasite/nuasite/blob/main/packages/cli/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nuasite/nuasite.git",
		"directory": "packages/cli"
	},
	"bin": {
		"nua": "src/index.ts"
	},
	"scripts": {
		"build": "bun build --target=bun --outdir=dist --external lightningcss --external @vitejs/devtools --external esbuild src/index.ts",
		"prepack": "bun run ../../scripts/workspace-deps/resolve-deps.ts"
	},
	"dependencies": {
		"@astrojs/compiler": "^4.0.0",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@nuasite/cms": "workspace:*",
		"@nuasite/cms-core": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:build"
	},
	"peerDependencies": {
		"typescript": "catalog:build"
	}
}
