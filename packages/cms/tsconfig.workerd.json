// The entries a Worker host compiles, checked without the DOM library and with the `workerd`
// condition, as such a host compiles them.
{
	"extends": "../../tsconfig.settings.json",
	"compilerOptions": {
		"noEmit": true,
		"composite": false,
		"incremental": false,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"lib": ["ESNext"],
		"types": ["@types/bun"],
		"customConditions": ["workerd"]
	},
	"files": [
		"src/editor-host.ts",
		"src/fields.ts",
		"src/markdown/remark.ts",
		"src/markdown/rehype.ts",
		"../cms-sidecar/src/portable.ts"
	]
}
