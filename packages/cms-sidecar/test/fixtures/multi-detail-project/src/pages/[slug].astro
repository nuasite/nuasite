---
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
	const [products, references] = await Promise.all([
		getCollection('products'),
		getCollection('references'),
	])
	return [
		...products.map((entry) => ({ params: { slug: entry.data.slug }, props: { type: 'product', entry } })),
		...references.map((entry) => ({ params: { slug: entry.data.slug }, props: { type: 'reference', entry } })),
	]
}

const { entry } = Astro.props
---

<h1>{entry.data.title}</h1>
